# Public Firebase browser configuration (identifiers only; never place Admin credentials here)
NEXT_PUBLIC_FIREBASE_API_KEY=replace_with_public_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_with_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace_with_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_with_bucket_name
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=replace_with_app_id
NEXT_PUBLIC_APP_URL=https://replace-with-deployed-origin.example

# Firebase Admin runtime credentials (inject from the approved secret manager)
FIREBASE_PROJECT_ID=replace_with_project_id
FIREBASE_CLIENT_EMAIL=replace_with_service_account_identity
FIREBASE_PRIVATE_KEY=replace_with_secret_manager_reference_or_runtime_injection
FIREBASE_STORAGE_BUCKET=replace_with_bucket_name

# Session, cursor, and authorization integrity secrets
SESSION_COOKIE_SECRET=replace_with_secret_manager_reference_or_runtime_injection
APPLICATION_READ_CURSOR_SECRET=replace_with_secret_manager_reference_or_runtime_injection
GOVERNANCE_CURSOR_SECRET=replace_with_secret_manager_reference_or_runtime_injection
LEGACY_OWNERSHIP_CURSOR_SECRET=replace_with_secret_manager_reference_or_runtime_injection
LEGACY_OWNERSHIP_OPERATIONAL_CURSOR_SECRET=replace_with_secret_manager_reference_or_runtime_injection

# Worker service principals
WORKER_FILES_SERVICE_ID=replace_with_named_principal_id
WORKER_FILES_CREDENTIAL_VERSION=replace_with_credential_version
WORKER_FILES_CREDENTIAL=replace_with_secret_manager_reference_or_runtime_injection
WORKER_AI_SERVICE_ID=replace_with_named_principal_id
WORKER_AI_CREDENTIAL_VERSION=replace_with_credential_version
WORKER_AI_CREDENTIAL=replace_with_secret_manager_reference_or_runtime_injection

# Scheduler service principal
SCHEDULER_SERVICE_ID=replace_with_named_principal_id
SCHEDULER_CREDENTIAL_VERSION=replace_with_credential_version
SCHEDULER_CREDENTIAL=replace_with_secret_manager_reference_or_runtime_injection

# Legacy inventory principal and production gate
LEGACY_INVENTORY_SERVICE_ID=replace_with_named_principal_id
LEGACY_INVENTORY_CREDENTIAL_VERSION=replace_with_credential_version
LEGACY_INVENTORY_CREDENTIAL=replace_with_secret_manager_reference_or_runtime_injection
LEGACY_OWNERSHIP_INVENTORY_OPERATIONAL_ENABLED=false
LEGACY_OWNERSHIP_INVENTORY_ALLOWED_ENVIRONMENTS=replace_with_approved_environment
LEGACY_OWNERSHIP_INVENTORY_ALLOWED_PROJECTS=replace_with_approved_project_id

# Billing provider configuration
STRIPE_SECRET_KEY=replace_with_secret_manager_reference_or_runtime_injection
STRIPE_INTRO_PRICE_ID=replace_with_approved_price_id
