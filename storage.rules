rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Legacy application objects are unresolved and have no browser authority.
    match /applications/{applicationId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Canonical mortgage documents and report artifacts are server/Admin only.
    match /tenants/{tenantId}/applications/{applicationId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
