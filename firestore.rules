rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // User profiles are server-managed and contain no authorization authority.
    // Browser users may read only their own safe profile projection.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Underwriter eligibility is derived server-side from active tenant memberships.
    // Legacy underwriter records grant no browser authority.
    match /underwriters/{id} {
      allow read, create, update, delete: if false;
    }

    // Applications collection
    // - All production application access is server-authoritative
    // - No browser principal may create, read, update, or delete applications
    match /applications/{id} {
      allow read: if false; // SEC-002: browser reads use authenticated server projections.
      allow create: if false; // SEC-002: application creation is server-authoritative.
      allow update: if false; // SEC-002: application updates are server-authoritative.
      allow delete: if false; // SEC-002: application deletion is disabled pending approved retention policy.
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
