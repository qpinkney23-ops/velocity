// TEST ONLY. NOT DEPLOYABLE PRODUCTION RULES.
// Admin SDK bypass is outside client rules and must be enforced in worker code.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function memberPath(tenantId, uid) {
      return /databases/(default)/documents/tenants/$(tenantId)/members/$(uid);
    }
    function appPath(applicationId) {
      return /databases/(default)/documents/applications/$(applicationId);
    }
    function activeClientMember(tenantId) {
      return request.auth != null &&
        firestore.get(memberPath(tenantId, request.auth.uid)).data.membershipStatus == "active" &&
        firestore.get(memberPath(tenantId, request.auth.uid)).data.tenantId == tenantId &&
        firestore.get(memberPath(tenantId, request.auth.uid)).data.userId == request.auth.uid &&
        firestore.get(memberPath(tenantId, request.auth.uid)).data.role in ["owner", "processor", "underwriter", "viewer"];
    }
    function matchingOwnership(tenantId, applicationId) {
      let app = firestore.get(appPath(applicationId)).data;
      return app.tenantId == tenantId && app.ownershipState == "tenant_owned" &&
        request.resource.metadata.tenantId == tenantId && request.resource.metadata.applicationId == applicationId;
    }
    match /tenants/{tenantId}/applications/{applicationId}/documents/{documentId}/{fileName} {
      allow read: if activeClientMember(tenantId) &&
        firestore.get(appPath(applicationId)).data.tenantId == tenantId;
      allow write: if activeClientMember(tenantId) &&
        firestore.get(memberPath(tenantId, request.auth.uid)).data.role in ["owner", "processor"] &&
        matchingOwnership(tenantId, applicationId);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
