rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function role() { return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : ""; }
    function isAdmin() { return role() == "admin"; }
    match /applications/{id} {
      allow create, read, update: if false;
      // Rollback-only artifact: restores the immediately preceding delete posture.
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
